# Server Configuration
APP_NAME="SIAKAD Mini API"
APP_ENV=development
APP_PORT=8080
ALLOWED_ORIGINS="*"

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSLMODE=disable

# JWT Authentication (minimal 32 karakter)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_ISSUER=siakad-mini
JWT_ACCESS_TTL_MINUTES=1440

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=1
